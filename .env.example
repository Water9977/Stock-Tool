# Upstox Developer API Credentials
UPSTOX_CLIENT_ID=your_client_id_here
UPSTOX_CLIENT_SECRET=your_client_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Upstox User Login Details (Required for daily headless 2FA login)
UPSTOX_MOBILE_NUMBER=your_mobile_number_here
UPSTOX_PIN=your_6_digit_pin_here
UPSTOX_TOTP_SECRET=your_external_totp_secret_key_here

# Risk Management Safety Limits
MAX_DAILY_LOSS=2000.0
MAX_CAPITAL_PER_TRADE=5000.0

# Trading Mode: set to VIRTUAL or LIVE
TRADING_MODE=VIRTUAL

# Gemini API Key (Required for Cold Path news analysis)
GEMINI_API_KEY=your_gemini_api_key_here
